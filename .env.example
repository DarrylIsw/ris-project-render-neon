# Local development only; Plesk Passenger injects PORT in production.
NODE_ENV=development
PORT=3001
HOST=
TRUST_PROXY_HOPS=0
# Development defaults. For Plesk production, configure the keys in .env.production.example
# through Plesk's environment settings. Passenger supplies PORT; leave HOST unset.
# TRUST_PROXY_HOPS must match the trusted proxy chain forwarding X-Forwarded-Proto.
MFA_ENCRYPTION_KEY=

# Set DATABASE_URL for Prisma CLI migrations; the server also accepts PG* or DB* variables.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
FILE_STORAGE_BACKEND=local
FILE_STORAGE_DIR=var/uploads
FILE_STORAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Word -> PDF. Install LibreOffice on the host; leave empty for automatic discovery.
LIBREOFFICE_PATH=
LETTER_PLACE=
LETTER_SIGNER_NAME=
LETTER_SIGNER_TITLE=

# Observability
SERVICE_NAME=ris-web
SENTRY_DSN=

# Transactional email is delivered only through SMTP. Use the SMTP login/key, not an API key.
EMAIL_ENABLED=false
APP_BASE_URL=http://localhost:3001
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_BRAND_NAME=Research Information System
EMAIL_SUPPORT_ADDRESS=

# Brevo SMTP (or another trusted SMTP relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Delivery safety. In development, choose redirect, allowlist, or explicit direct delivery.
# Direct delivery sends notifications to each recipient's registered account email.
EMAIL_REDIRECT_ALL_TO=
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_ALLOW_DIRECT_DELIVERY=false

# Near-real-time transactional outbox. LISTEN/NOTIFY wakes the worker after a
# committed event; fallback polling recovers missed notifications/restarts.
EMAIL_QUEUE_FALLBACK_POLL_MS=5000
EMAIL_QUEUE_BATCH_SIZE=25
EMAIL_SEND_CONCURRENCY=5
EMAIL_PROCESSING_TIMEOUT_MINUTES=10
EMAIL_WORKER_ID=

# Reusable Nodemailer SMTP pool.
EMAIL_SMTP_MAX_CONNECTIONS=5
EMAIL_SMTP_MAX_MESSAGES=100

# Legacy aliases are still understood during deployment migration.
EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=5
EMAIL_MAX_AGE_HOURS=72
EMAIL_RETRY_BASE_MS=60000
EMAIL_STALE_LOCK_MINUTES=15
