# Reference only. Set these values in Plesk > Node.js > Custom Environment Variables.
NODE_ENV=production
# Passenger injects PORT. Leave PORT and HOST unset in Plesk.
TRUST_PROXY_HOPS=
APP_BASE_URL=
MFA_ENCRYPTION_KEY=

# Set DATABASE_URL explicitly in Plesk; Prisma Migrate requires it as well.
# URL-encode special characters in the username/password.
DATABASE_URL=
# The server also accepts PG* or DB* variables at runtime, but migrations do not.
# DATABASE_SSL=true makes Prisma require TLS and validate the database certificate.
# Provide the CA certificate/sslcert option if the database uses a private CA.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Use a persistent directory writable by the Plesk application user.
FILE_STORAGE_DIR=

# Enable only after the SMTP sender/domain and credentials are verified.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Leave both empty to deliver to each notification recipient's registered email.
EMAIL_REDIRECT_ALL_TO=
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_QUEUE_FALLBACK_POLL_MS=5000
EMAIL_QUEUE_BATCH_SIZE=25
EMAIL_SEND_CONCURRENCY=5
EMAIL_PROCESSING_TIMEOUT_MINUTES=10
EMAIL_SMTP_MAX_CONNECTIONS=5
EMAIL_SMTP_MAX_MESSAGES=100

# Optional monitoring service; never place this value in frontend configuration.
SENTRY_DSN=
