NODE_ENV=production
APP_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
TRUST_PROXY_HOPS=1
# Optional. Keep false so all users sign in with email and password only.
MFA_REQUIRED=false
# Required only when MFA_REQUIRED=true.
# MFA_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS

# Neon ris-testing project, database ris_db_neon. Replace the password placeholder.
# Pooled connection for Prisma application queries.
DATABASE_URL=postgresql://ris_db_neon_owner:REPLACE_WITH_NEON_PASSWORD@ep-blue-mouse-b3crwadb-pooler.c-4.ap-southeast-1.aws.neon.tech/ris_db_neon?sslmode=require&channel_binding=require
# Direct connection for Prisma migrations and PostgreSQL LISTEN/NOTIFY.
DATABASE_URL_UNPOOLED=postgresql://ris_db_neon_owner:REPLACE_WITH_NEON_PASSWORD@ep-blue-mouse-b3crwadb.c-4.ap-southeast-1.aws.neon.tech/ris_db_neon?sslmode=require&channel_binding=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

FILE_STORAGE_BACKEND=s3
FILE_STORAGE_BUCKET=ris-testing-files
# Set these as secret environment variables in Render; do not commit their values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-royal-sun-b3wp1lci.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1

# Email is intentionally disabled for the first deploy.
EMAIL_ENABLED=false
EMAIL_ALLOW_DIRECT_DELIVERY=false
