  id                              String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                            String                           @db.VarChar(220)
  description                     String
  start_date                      DateTime                         @db.Date
  end_date                        DateTime                         @db.Date
  registration_start_at           DateTime                         @db.Timestamptz(6)
  registration_end_at             DateTime                         @db.Timestamptz(6)
  year                            Int                              @db.SmallInt
  maximum_budget                  Decimal                          @db.Decimal(16, 2)
  status                          scheme_status_type               @default(draft)
  filters                         Json                             @default("{}")
  created_by                      String                           @db.Uuid
  version                         Int                              @default(1)
  published_at                    DateTime?                        @db.Timestamptz(6)
  archived_at                     DateTime?                        @db.Timestamptz(6)
  deleted_at                      DateTime?                        @db.Timestamptz(6)
  deleted_by                      String?                          @db.Uuid
  created_at                      DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                         @default(now()) @db.Timestamptz(6)
  funded_research                 funded_research[]
  research_drafts                 research_drafts[]
  scheme_attachment_requirements  scheme_attachment_requirements[]
  scheme_eligible_users           scheme_eligible_users[]
  scheme_filter_rules             scheme_filter_rules[]
  scheme_output_options           scheme_output_options[]
  scheme_registration_extensions  scheme_registration_extensions[]
  scheme_reporting_periods        scheme_reporting_periods[]
  users_schemes_created_byTousers users                            @relation("schemes_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_schemes_deleted_byTousers users?                           @relation("schemes_deleted_byTousers", fields: [deleted_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, registration_start_at, registration_end_at], map: "schemes_status_registration_idx")
  @@index([year(sort: Desc)])
}

