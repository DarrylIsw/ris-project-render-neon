  extension                                                            String?                          @db.VarChar(20)
  size_bytes                                                           BigInt
  checksum_sha256                                                      String?                          @db.VarChar(64)
  status                                                               file_status_type                 @default(ready)
  metadata                                                             Json                             @default("{}")
  uploaded_at                                                          DateTime                         @default(now()) @db.Timestamptz(6)
  deleted_at                                                           DateTime?                        @db.Timestamptz(6)
  draft_files                                                          draft_files[]
  external_research_files                                              external_research_files[]
  external_research_outputs                                            external_research_outputs[]
  funding_letters                                                      funding_letters[]
  generated_letters                                                    generated_letters[]
  letter_files                                                         letter_files[]
  letter_requests                                                      letter_requests[]
  logbook_files                                                        logbook_files[]
  previous_ethics_clearances                                           previous_ethics_clearances[]
  research_contracts_research_contracts_signed_file_idTostored_files   research_contracts[]             @relation("research_contracts_signed_file_idTostored_files")
  research_contracts_research_contracts_template_file_idTostored_files research_contracts[]             @relation("research_contracts_template_file_idTostored_files")
  research_monev_files                                                 research_monev_files[]
  research_report_files                                                research_report_files[]
  researcher_documents                                                 researcher_documents[]
  researcher_profiles                                                  researcher_profiles[]
  scheme_attachment_requirements                                       scheme_attachment_requirements[]
  users                                                                users?                           @relation(fields: [owner_user_id], references: [id], onUpdate: NoAction)

  @@index([owner_user_id, uploaded_at(sort: Desc)], map: "stored_files_owner_idx")
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model submission_reviews {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id        String                     @unique @db.Uuid
  recommendation       review_recommendation_type
  total_score          Decimal                    @db.Decimal(6, 2)
  strengths            String?
  weaknesses           String?
  budget_notes         String?
  output_notes         String?
  revision_notes       String?
  submitted_at         DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                   @default(now()) @db.Timestamptz(6)
  review_score_details review_score_details[]
  reviewer_assignments reviewer_assignments       @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model system_activity_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id  String?  @db.VarChar(180)
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(120)
  entity_type String   @db.VarChar(100)
  entity_id   String?  @db.Uuid
  old_data    Json?
  new_data    Json?
  ip_address  String?  @db.Inet
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "system_activity_logs_entity_idx")
  @@index([user_id, created_at(sort: Desc)], map: "system_activity_logs_user_idx")
}

model user_admin_scopes {
  id                                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                    String           @db.Uuid
  scope                                      admin_scope_type
  assigned_by                                String?          @db.Uuid
  assigned_at                                DateTime         @default(now()) @db.Timestamptz(6)
  users_user_admin_scopes_assigned_byTousers users?           @relation("user_admin_scopes_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  admin_scopes                               admin_scopes     @relation(fields: [scope], references: [code], onDelete: NoAction, onUpdate: NoAction)
  users_user_admin_scopes_user_idTousers     users            @relation("user_admin_scopes_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, scope])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_sessions {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  ip_address String?   @db.Inet
  user_agent String?
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  mfa_verified_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at(sort: Desc)], map: "user_sessions_user_expiry_idx")
}

model user_mfa {
  user_id           String    @id @db.Uuid
  secret_ciphertext String
  confirmed_at      DateTime? @db.Timestamptz(6)
  last_used_step    BigInt    @default(-1)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

