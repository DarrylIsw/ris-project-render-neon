generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ris_records {
  domain     String   @db.VarChar(80)
  entity_id  String   @db.VarChar(180)
  payload    Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([domain, entity_id])
}

model ris_revision {
  id         Int      @id
  version    Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model account_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  purpose     String    @db.VarChar(40)
  token_hash  String    @unique
  payload     Json      @default("{}")
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model admin_assignments {
  id                                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id                                 String              @db.Uuid
  admin_id                                   String              @db.Uuid
  assigned_by                                String?             @db.Uuid
  assigned_at                                DateTime            @default(now()) @db.Timestamptz(6)
  ended_at                                   DateTime?           @db.Timestamptz(6)
  users_admin_assignments_admin_idTousers    users               @relation("admin_assignments_admin_idTousers", fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_admin_assignments_assigned_byTousers users?              @relation("admin_assignments_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  researcher_profiles                        researcher_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profile_id, admin_id])
}

model admin_scopes {
  code              admin_scope_type    @id
  name              String              @unique @db.VarChar(120)
  description       String?
  user_admin_scopes user_admin_scopes[]
}

model applicant_profiles {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?  @db.Uuid
  name           String   @db.VarChar(180)
  identifier     String?  @db.VarChar(80)
  applicant_role String?  @db.VarChar(120)
  applicant_kind String   @db.VarChar(80)
  status         String?  @db.VarChar(80)
  faculty        String?  @db.VarChar(180)
  study_program  String?  @db.VarChar(180)
  email          String?  @db.VarChar(320)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model budget_categories {
  code               String               @id @db.VarChar(40)
  name               String               @unique @db.VarChar(120)
  position           Int                  @db.SmallInt
  draft_budget_items draft_budget_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model draft_budget_items {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id          String             @db.Uuid
  category_code     String?            @db.VarChar(40)
  section_key       String?            @db.VarChar(128)
  section_label     String?            @db.VarChar(180)
  component         String             @db.VarChar(180)
  item_name         String             @db.VarChar(220)
  volume            Decimal            @db.Decimal(12, 2)
  unit              String             @db.VarChar(80)
  unit_price        Decimal            @db.Decimal(16, 2)
  total_amount      Decimal?           @default(dbgenerated("round((volume * unit_price), 2)")) @db.Decimal(16, 2)
  notes             String?
  position          Int                @db.SmallInt
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  budget_categories budget_categories? @relation(fields: [category_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  research_drafts   research_drafts    @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([draft_id, category_code, position])
  @@unique([draft_id, section_key, position])
  @@index([draft_id, category_code], map: "draft_budget_items_draft_idx")
}

model draft_files {
  id                             String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id                       String                          @db.Uuid
  requirement_id                 String?                         @db.Uuid
  category                       String                          @db.VarChar(100)
  file_id                        String                          @db.Uuid
  uploaded_by                    String?                         @db.Uuid
  uploaded_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  research_drafts                research_drafts                 @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stored_files                   stored_files                    @relation(fields: [file_id], references: [id], onUpdate: NoAction)
  scheme_attachment_requirements scheme_attachment_requirements? @relation(fields: [requirement_id], references: [id], onUpdate: NoAction)
  users                          users?                          @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)

  @@unique([draft_id, category])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model draft_members {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id            String               @db.Uuid
  role                member_role_type
  member_type         member_type
  profile_id          String?              @db.Uuid
  user_id             String?              @db.Uuid
  name                String               @db.VarChar(180)
  identifier          String?              @db.VarChar(80)
  nidn                String?              @db.VarChar(80)
  nim                 String?              @db.VarChar(80)
  study_program       String?              @db.VarChar(180)
  faculty             String?              @db.VarChar(180)
  orcid               String?              @db.VarChar(40)
  email               String?              @db.VarChar(320)
  position            Int                  @db.SmallInt
  metadata            Json                 @default("{}")
  research_drafts     research_drafts      @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  researcher_profiles researcher_profiles? @relation(fields: [profile_id], references: [id], onUpdate: NoAction)
  users               users?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([draft_id, position])
  @@index([profile_id], map: "draft_members_profile_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model draft_outputs {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id                String                 @db.Uuid
  scheme_output_option_id String?                @db.Uuid
  output_kind             output_kind_type
  name                    String                 @db.VarChar(220)
  category                String                 @db.VarChar(80)
  description             String
  configuration           Json                   @default("{}")
  position                Int                    @db.SmallInt
  created_at              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at              DateTime               @default(now()) @db.Timestamptz(6)
  research_drafts         research_drafts        @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scheme_output_options   scheme_output_options? @relation(fields: [scheme_output_option_id], references: [id], onUpdate: NoAction)
  research_reports        research_reports[]

  @@unique([draft_id, position])
  @@index([draft_id, output_kind], map: "draft_outputs_draft_kind_idx")
}

model draft_project_sdgs {
  project_id     String         @db.Uuid
  sdg_id         Int            @db.SmallInt
  draft_projects draft_projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sdg_goals      sdg_goals      @relation(fields: [sdg_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([project_id, sdg_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model draft_projects {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id                 String               @unique @db.Uuid
  title                    String
  abstract                 String?
  background               String?
  objectives               String?
  methodology              String?
  target_tkt               Int?                 @db.SmallInt
  rip_relation             String?              @db.VarChar(180)
  research_center_relation String?              @db.VarChar(180)
  research_center_other    String?              @db.VarChar(180)
  integrated_to_teaching   Boolean?
  course_name              String?              @db.VarChar(180)
  academic_year            String?              @db.VarChar(20)
  metadata                 Json                 @default("{}")
  created_at               DateTime             @default(now()) @db.Timestamptz(6)
  updated_at               DateTime             @default(now()) @db.Timestamptz(6)
  draft_project_sdgs       draft_project_sdgs[]
  research_drafts          research_drafts      @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
